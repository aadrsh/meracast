<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3 colour palette — light theme.
        Use m3_material_color_utilities (or Material Theme Builder) to generate
        these from a seed colour. Ref: https://m3.material.io/styles/color
    -->

    <!-- Primary — #FF1A73E8 (Google Blue) -->
    <color name="m3_primary">#FF1A73E8</color>
    <color name="m3_on_primary">#FFFFFFFF</color>
    <color name="m3_primary_container">#FFD3E3FF</color>
    <color name="m3_on_primary_container">#FF001D36</color>

    <!-- Secondary — #FF34A853 (Green) -->
    <color name="m3_secondary">#FF34A853</color>
    <color name="m3_on_secondary">#FFFFFFFF</color>
    <color name="m3_secondary_container">#FFCEE9D2</color>
    <color name="m3_on_secondary_container">#FF00210E</color>

    <!-- Tertiary — #FF7C5800 (Amber accent) -->
    <color name="m3_tertiary">#FF7C5800</color>
    <color name="m3_on_tertiary">#FFFFFFFF</color>

    <!-- Error — #FFD93025 (Google Red) -->
    <color name="m3_error">#FFD93025</color>
    <color name="m3_on_error">#FFFFFFFF</color>
    <color name="m3_error_container">#FFF9DEDC</color>
    <color name="m3_on_error_container">#FF410E0B</color>

    <!-- Background & Surface (light) -->
    <color name="m3_background">#FFF8F9FA</color>
    <color name="m3_on_background">#FF202124</color>
    <color name="m3_surface">#FFFFFFFF</color>
    <color name="m3_on_surface">#FF202124</color>
    <color name="m3_surface_variant">#FFE0E3E7</color>
    <color name="m3_on_surface_variant">#FF44474F</color>

    <!-- Outline / Divider -->
    <color name="m3_outline">#FF74777F</color>
    <color name="m3_outline_variant">#FFC4C6D0</color>

    <!-- ── App-specific colours (kept from original) ────────── -->
    <color name="status_green">#FF34A853</color>
    <color name="status_red">#FFD93025</color>
    <color name="status_yellow">#FFFBBC04</color>
    <color name="dark_surface">#FF1F1F1F</color>

    <!-- Legacy aliases (used elsewhere in code) — map to M3 values -->
    <color name="primary">@color/m3_primary</color>
    <color name="primary_variant">#FF1557B0</color>
    <color name="on_primary">@color/m3_on_primary</color>
    <color name="secondary">@color/m3_secondary</color>
    <color name="on_secondary">@color/m3_on_secondary</color>
    <color name="background">@color/m3_background</color>
    <color name="on_background">@color/m3_on_background</color>
    <color name="surface">@color/m3_surface</color>
    <color name="on_surface">@color/m3_on_surface</color>
    <color name="error">@color/m3_error</color>
</resources>
